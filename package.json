{
  "name": "dineflow",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "node scripts/db-docker.mjs up",
    "db:down": "node scripts/db-docker.mjs down",
    "db:migrate": "node --experimental-strip-types packages/db/src/migrate.ts",
    "test": "npm run test -w @dineflow/shared && npm run test -w @dineflow/web",
    "harness": "npm run harness --workspace @dineflow/db",
    "restore-drill": "node scripts/restore-drill/run.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @dineflow/web",
    "test:db": "npm run harness -w @dineflow/db",
    "test:api": "npm run test -w @dineflow/api",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "dev:api": "npm run dev -w @dineflow/api",
    "dev:web": "npm run dev -w @dineflow/web"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
