# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Full reference: docs/ENVIRONMENT.md
NODE_ENV=development
PORT=4000

# Must use the dineflow_api role. The API refuses to start on a role that can bypass RLS.
DATABASE_URL=postgres://dineflow_api:CHANGE_ME@localhost:55432/dineflow

WEB_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Full access to the project. Treat as the most sensitive value in the system.
SUPABASE_SERVICE_KEY=
# Only for legacy HS256 projects. Leave empty when the project publishes a JWKS.
SUPABASE_JWT_SECRET=

# Signs table QR tokens. REQUIRED — the API will not start without it, and there is
# no fallback. Format: kid:secret, secret = at least 32 random bytes as base64url
# (no padding). Use a different key in every environment; never reuse the local one.
# Generate straight to the clipboard so it is never shown:
#   node -e "process.stdout.write('1:' + require('crypto').randomBytes(32).toString('base64url'))" | pbcopy
# Full procedure, rotation and compromise response: docs/runbooks/qr-signing-key.md
QR_SIGNING_KEYS=
# Optional: which listed key signs new codes. Leave empty to use the highest key id.
QR_SIGNING_KEY_ID=
# Leave false until the public domain is permanent; QR cards stay watermarked until then.
QR_DOMAIN_FINAL=false
